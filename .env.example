# ============================================================
# Satuna Ajar - Environment Example
# Salin file ini menjadi .env.local untuk development.
# JANGAN isi secret asli di file yang di-commit ke GitHub.
# ============================================================

# AI ---------------------------------------------------------
# Server-only. Jangan beri prefix NEXT_PUBLIC_.
GEMINI_API_KEY="your-gemini-api-key"

# Authentication --------------------------------------------
# Pilihan: disabled | optional | enforce
SATUNA_AUTH_MODE="optional"

# Nilai ini memang public dan boleh dikirim ke browser.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Gunakan sb_secret_... dari Supabase API Keys.
SUPABASE_SECRET_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Admin ------------------------------------------------------
SATUNA_ADMIN_EMAILS=""

# Payments ---------------------------------------------------
# Kosongkan selama gateway masih review. Setelah adapter aktif: ipaymu | midtrans
SATUNA_PAYMENT_PROVIDER=""

# Trial protection ------------------------------------------
TRIAL_PROTECTION_MODE="enforce"
TRIAL_FREE_GENERATIONS="3"
TRIAL_SIGNING_SECRET="replace-with-a-long-random-secret"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Development / AI Studio only ------------------------------
# DISABLE_HMR="false"
