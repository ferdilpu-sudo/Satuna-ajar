# ============================================================
# Satuna Ajar - Environment Example
# Salin file ini menjadi .env.local untuk development.
# JANGAN isi secret asli di file yang di-commit ke GitHub.
# ============================================================

# AI ---------------------------------------------------------
# Server-only. Jangan beri prefix NEXT_PUBLIC_.
GEMINI_API_KEY="your-gemini-api-key"

# Authentication --------------------------------------------
# Pilihan: disabled | optional | enforce
# optional: auth aktif bila Supabase dikonfigurasi, workspace masih bisa dibuka tanpa login.
# enforce : semua workspace/API non-public wajib login. Gunakan setelah Supabase siap.
# disabled: bypass auth, berguna hanya untuk troubleshooting/local tertentu.
SATUNA_AUTH_MODE="optional"

# Nilai ini memang public dan boleh dikirim ke browser.
# Gunakan Project URL + Publishable/Anon key dari Supabase.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Gunakan sb_secret_... dari Supabase API Keys.
# Legacy SUPABASE_SERVICE_ROLE_KEY tetap didukung sebagai fallback backend.
# JANGAN pernah beri prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Admin ------------------------------------------------------
# Server-only bootstrap allowlist. Pisahkan beberapa email dengan koma.
# Setelah admin_members sudah diisi di Supabase, variabel ini boleh dikosongkan.
SATUNA_ADMIN_EMAILS=""

# Trial protection ------------------------------------------
# Pilihan: enforce | monitor | disabled | auto
# Production yang sudah memakai persistent Redis: enforce.
TRIAL_PROTECTION_MODE="enforce"

# Jumlah pembuatan dokumen AI gratis per akun/trial.
TRIAL_FREE_GENERATIONS="3"

# Secret panjang dan acak untuk menandatangani trial cookie
# sekaligus meng-hash subject akun pada usage store.
TRIAL_SIGNING_SECRET="replace-with-a-long-random-secret"

# Persistent quota store untuk production serverless.
# Wajib untuk production ketika TRIAL_PROTECTION_MODE="enforce".
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Development / AI Studio only ------------------------------
# Optional. Set true hanya bila perlu menonaktifkan webpack watcher
# pada environment preview tertentu.
# DISABLE_HMR="false"
